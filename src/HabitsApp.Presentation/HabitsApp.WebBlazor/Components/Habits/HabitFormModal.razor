@if (IsOpen)
{
    <div class="modal-overlay" @onclick="Close">
        <div class="modal" @onclick:stopPropagation>
            <div class="modal__head">
                <h3 class="headline-md">@(Habit is null ? "New Habit" : IsReadOnly ? "View Habit" : "Edit Habit")</h3>
                <button class="modal__close" title="Close" aria-label="Close" @onclick="Close">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <EditForm Model="@Form" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="modal__error">@ErrorMessage</div>
                }

                <div class="habit-form__field">
                    <label class="field-label" for="habit-title">Title</label>
                    <InputText id="habit-title" class="field" @bind-Value="Form.Title" disabled="@IsReadOnly" placeholder="e.g. Morning meditation" />
                    <ValidationMessage For="@(() => Form.Title)" />
                </div>

                <div class="habit-form__field">
                    <label class="field-label" for="habit-description">Description</label>
                    <InputText id="habit-description" class="field" @bind-Value="Form.Description" disabled="@IsReadOnly" placeholder="Optional note" />
                </div>

                <div class="habit-form__field">
                    <label class="field-label">Color</label>
                    <div class="habit-form__color-options">
                        @foreach (var color in Colors)
                        {
                            <button type="button"
                                    class="habit-form__color @(Form.ColorHex == color ? "habit-form__color--selected" : "")"
                                    style="background: @color;"
                                    title="@color"
                                    aria-label="@color"
                                    disabled="@IsReadOnly"
                                    @onclick="() => SelectColor(color)"></button>
                        }
                    </div>
                </div>

                <div class="habit-form__field">
                    <label class="field-label">Frequency</label>
                    <div class="habit-form__segmented">
                        @foreach (var frequency in Frequencies)
                        {
                            <button type="button"
                                    class="habit-form__segment @(Form.Frequency == frequency ? "habit-form__segment--selected" : "")"
                                    disabled="@IsReadOnly"
                                    @onclick="() => SelectFrequency(frequency)">@frequency</button>
                        }
                    </div>
                </div>

                <div class="habit-form__field">
                    <label class="field-label">Time of day</label>
                    <div class="habit-form__segmented">
                        @foreach (var period in Periods)
                        {
                            <button type="button"
                                    class="habit-form__segment @(Form.Period == period ? "habit-form__segment--selected" : "")"
                                    disabled="@IsReadOnly"
                                    @onclick="() => SelectPeriod(period)">@period</button>
                        }
                    </div>
                </div>

                <div class="habit-form__field">
                    <label class="field-label" for="habit-target">Target per period</label>
                    <InputNumber id="habit-target" class="field" @bind-Value="Form.TargetCount" disabled="@IsReadOnly" />
                    <ValidationMessage For="@(() => Form.TargetCount)" />
                </div>

                <div class="modal__footer">
                    <button type="button" class="btn btn-secondary" @onclick="Close" disabled="@(IsSaving || ControlsDisabled)">Cancel</button>
                    @if (Habit is not null && !IsReadOnly)
                    {
                        <button type="button" class="btn btn-warning" @onclick="HandleInactivateAsync" disabled="@(IsSaving || ControlsDisabled)">Inactivate</button>
                    }
                    @if (IsReadOnly)
                    {
                        <button type="button" class="btn btn-primary" @onclick="HandleReactivateAsync" disabled="@IsSaving">Reactivar</button>
                    }
                    <button type="submit" class="btn btn-primary" disabled="@(IsSaving || IsReadOnly || ControlsDisabled)">@(IsSaving ? "Saving…" : "Save")</button>
                </div>
            </EditForm>
        </div>
    </div>
}