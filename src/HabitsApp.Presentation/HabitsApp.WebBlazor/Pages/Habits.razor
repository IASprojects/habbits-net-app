@page "/habits"
@attribute [Authorize]
@using HabitsApp.WebBlazor.Components

<div class="stack-lg">
    <section class="dashboard-head">
        <div>
            <p class="label-caps dashboard-head__eyebrow">Welcome back,</p>
            <h1 class="dashboard-head__greeting">Hello, @FirstName</h1>

            <div class="period-badge">
                <span class="material-symbols-outlined period-badge__icon">@CurrentPeriodIcon</span>
                <span class="period-badge__label">@CurrentPeriodLabel</span>
            </div>
        </div>

        @if (ActiveOnly)
        {
            <div class="glass-panel momentum-panel">
                <MomentumRing Percent="@MomentumPercent" />
                <div>
                    <h2 class="momentum-panel__title">Daily Momentum</h2>
                    <p class="momentum-panel__sub">@CompletedCount of @TotalCount habits completed</p>
                </div>
            </div>
        }
    </section>

    <section class="stack-md">
        <h2 class="dashboard-section__title">Today's Focus</h2>

        <div class="segment habits-view-switch" role="group" aria-label="Habit status" style="width: 25%;">
            <button class="segment__btn @(ActiveOnly ? "segment__btn--active" : "")" @onclick="() => SetActiveView(true)">🟢 Active</button>
            <button class="segment__btn @(!ActiveOnly ? "segment__btn--active segment__btn--danger" : "")" @onclick="() => SetActiveView(false)">🔴 Inactive</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage) && !ShowModal)
        {
            <div class="auth-card__error">@ErrorMessage</div>
        }

        @if (IsLoading)
        {
            <div class="habits-loading">
                <div class="checking-page__spinner"></div>
            </div>
        }
        else if (HabitItems.Count == 0)
        {
            <div class="glass-panel habits-empty">
                @if (ActiveOnly)
                {
                    <span class="material-symbols-outlined habits-empty__icon">add_circle</span>
                    <h3 class="habits-empty__title">No habits yet</h3>
                    <p class="habits-empty__text">Start your streak by creating your first habit.</p>
                    <button class="btn btn-primary" @onclick="OpenCreate">Create a habit</button>
                }
                else
                {
                    <span class="material-symbols-outlined habits-empty__icon">history</span>
                    <h3 class="habits-empty__title">No inactive habits</h3>
                    <p class="habits-empty__text">Everything is active. Inactivated habits will appear here.</p>
                }
            </div>
        }
        else
        {
            <div class="habits-list">
                @foreach (var habit in HabitItems)
                {
                    <HabitCard Habit="@habit" CurrentPeriod="@CurrentPeriod" OnEdit="@OpenEdit" OnQuickLog="@HandleQuickLog" />
                }
            </div>
        }
    </section>
</div>

<button class="fab" title="Add habit" aria-label="Add habit" @onclick="OpenCreate">
    <span class="material-symbols-outlined">add</span>
</button>

<HabitFormModal IsOpen="@ShowModal"
                Habit="@EditingHabit"
                IsSaving="@IsSaving"
                ErrorMessage="@ModalErrorMessage"
                OnSave="@HandleModalSave"
                OnReactivate="@RequestReactivate"
                OnInactivate="@RequestInactivate"
                OnClose="@CloseModal" />

<ConfirmDialog IsOpen="@ShowInactivateConfirm"
               Title="Inactivate habit"
               Message="Confirmo que deseo inactivar"
               ErrorMessage="@ConfirmErrorMessage"
               ConfirmLabel="Inactivar"
               IsWarning="true"
               IsBusy="@IsConfirmBusy"
               OnConfirm="@HandleInactivateConfirmed"
               OnCancel="@CancelConfirmation" />

<ConfirmDialog IsOpen="@ShowRestoreConfirm"
               Title="Reactivate habit"
               Message="Confirmo que deseo reactivar"
               ErrorMessage="@ConfirmErrorMessage"
               ConfirmLabel="Reactivar"
               IsBusy="@IsConfirmBusy"
               OnConfirm="@HandleRestoreConfirmed"
               OnCancel="@CancelConfirmation" />