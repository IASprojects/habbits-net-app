@page "/"

<PageTitle>HabitsApp</PageTitle>

<AuthorizeView>
    <NotAuthorized>
        <div class="ambient-glow" aria-hidden="true"></div>

        <div class="auth-page landing">
            <div class="glass-card auth-card auth-card--login">
                <header class="auth-card__hero">
                    <h1 class="display-lg auth-card__brand">HabitsApp</h1>
                    <p class="body-lg auth-card__tagline">Small steps, lasting change.</p>
                </header>

                <EditForm Model="@Model" OnValidSubmit="HandleValidSubmit" Context="loginForm">
                    <DataAnnotationsValidator />

                    <div class="stack-md">
                        <div class="float-field">
                            <InputText id="email" @bind-Value="Model.Email" class="float-field__input" placeholder="Email address" autocomplete="email" />
                            <label for="email" class="float-field__label">Email address</label>
                            <ValidationMessage For="() => Model.Email" class="validation-message" />
                        </div>

                        <div class="float-field">
                            <InputText
                                id="password"
                                type="@(ShowPassword ? "text" : "password")"
                                @bind-Value="Model.Password"
                                class="float-field__input float-field__input--with-toggle"
                                placeholder="Password"
                                autocomplete="current-password" />
                            <label for="password" class="float-field__label">Password</label>
                            <button
                                type="button"
                                class="float-field__toggle"
                                @onclick="TogglePassword"
                                aria-label="@(ShowPassword ? "Hide password" : "Show password")"
                                aria-pressed="@ShowPassword">
                                @if (ShowPassword)
                                {
                                    <svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M1.5 8s2.5-4 6.5-4 6.5 4 6.5 4-2.5 4-6.5 4S1.5 8 1.5 8Z" />
                                        <path d="M8 10.25a2.25 2.25 0 1 0 0-4.5 2.25 2.25 0 0 0 0 4.5Z" />
                                    </svg>
                                }
                                else
                                {
                                    <svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M9.2 6.8a2.25 2.25 0 0 0-3 3.25M1.5 8s2.5-4 6.5-4 6.5 4 6.5 4-2.5 4-6.5 4S1.5 8 1.5 8Z" />
                                        <path d="m2 2 12 12" />
                                    </svg>
                                }
                            </button>
                            <ValidationMessage For="() => Model.Password" class="validation-message" />
                        </div>

                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <div class="auth-card__error">
                                @ErrorMessage
                            </div>
                        }

                        <button type="submit" disabled="@IsSubmitting" class="btn btn-primary btn-block">
                            @(IsSubmitting ? "Signing in…" : "Sign In")
                        </button>
                    </div>
                </EditForm>

                <div class="auth-card__divider" aria-hidden="true"></div>

                <p class="auth-card__footer">
                    Don't have an account?
                    <NavLink class="auth-card__link" href="register">Register</NavLink>
                </p>
            </div>
        </div>
    </NotAuthorized>

    <Authorized>
        <div class="ambient-glow" aria-hidden="true"></div>

        <div class="auth-page landing">
            <div class="glass-card auth-card auth-card--login auth-card--logged-in">
                <header class="auth-card__hero">
                    <h1 class="headline-md auth-card__title">You're logged in</h1>
                    <p class="body-lg auth-card__tagline">Welcome back.</p>
                </header>
            </div>
        </div>
    </Authorized>
</AuthorizeView>